# Copie para .env.local. Variáveis com prefixo VITE_ vão para o bundle do navegador:
# nunca coloque chaves secretas nelas.

# Supabase (Project Settings → API). Use a chave publicável/anon, NUNCA a service_role.
# Sem estas variáveis o app funciona só com o progresso local. No Cloudflare Pages,
# cadastre as mesmas em Settings → Variables (Production e Preview).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fase 5 (pipeline de conteúdo, roda só no servidor/local)
# ANTHROPIC_API_KEY=
