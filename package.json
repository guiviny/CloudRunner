{
  "name": "cloudrunner",
  "private": true,
  "workspaces": [
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "npm run test -w apps/web",
    "test:coverage": "npm run test -w apps/web -- --coverage",
    "typecheck": "npm run typecheck -w apps/web",
    "lint": "npm run lint -w apps/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0"
  },
  "engines": {
    "node": ">=24"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md,yml,yaml,html}": "prettier --write",
    "apps/web/src/**/*.{ts,tsx}": "oxlint -c apps/web/.oxlintrc.json"
  }
}
